# Polygon PoS production. This file prepares an explicitly confirmed manual deployment.
BLOCKCHAIN_NETWORK=polygon
BLOCKCHAIN_CHAIN_ID=137
BLOCKCHAIN_RPC_URL=https://replace-with-approved-polygon-rpc

ADMIN_WALLET_ADDRESS=0xec5FcdFab3FCafCEFCED55CC702CD3B13f54B4Fe
SIGNER_WALLET_ADDRESS=0xBfA38182f0D24589e7898DD4892C58c3FDa58042

# Deployer-wallet secret. Required format: 0x followed by 64 hexadecimal characters.
# Load it from the VPS secret manager; never commit the real value.
DEPLOYER_PRIVATE_KEY=0xreplace-with-secret-manager-value
EXPECTED_DEPLOYER=replace-with-deployer-wallet-address
POLYGONSCAN_API_KEY=inject-from-secret-manager
THV_PROOF_REGISTRY_CONTRACT_ADDRESS=
SOURCE_COMMIT=replace-with-immutable-release-commit
# 1 POL in wei. Preflight also requires at least 2x the RPC gas estimate.
MINIMUM_DEPLOYER_BALANCE_WEI=1000000000000000000
THV_PROOF_REGISTRY_TEST_MODE=false

# Required only for the intentional manual Mainnet deployment command.
MAINNET_DEPLOY_CONFIRMATION=

# Never add a human signer private key to this file or to the THV application.
