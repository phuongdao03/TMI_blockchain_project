APP_ENV=local
RELEASE_MODE=full
NEXT_PUBLIC_RELEASE_MODE=full
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://tmi_local:tmi-local-only@postgres:5432/tmi_local
DATABASE_DIRECT_URL=postgresql+asyncpg://tmi_local:tmi-local-only@postgres:5432/tmi_local
DATABASE_NULL_POOL=false
REDIS_URL=redis://redis:6379/0
AUTH_OUTBOX_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY=
AUDIT_INTEGRITY_KEY=
AUDIT_INTEGRITY_KEY_ID=audit-v1
AUDIT_INTEGRITY_VERIFICATION_KEYS={}
AUDIT_RETENTION_DAYS=2555
AUTH_OUTBOX_KEY_ID=auth-registration-v1
STAFF_INVITATION_TTL_SECONDS=86400
FIREBASE_TOTP_ENABLED=false
STAFF_MFA_MAX_AGE_SECONDS=43200
AUTH_VERIFICATION_TTL_SECONDS=86400
AUTH_REGISTRATION_IP_LIMIT=20
AUTH_REGISTRATION_EMAIL_LIMIT=5
AUTH_REGISTRATION_RATE_WINDOW_SECONDS=900
ANVIL_RPC_URL=http://anvil:8545
JWT_SECRET=
AUTH_CSRF_SECRET=
AUTH_JWT_ISSUER=tmi-platform
AUTH_JWT_AUDIENCE=tmi-web
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_ACCESS_COOKIE_NAME=tmi_access
AUTH_REFRESH_COOKIE_NAME=tmi_refresh
AUTH_CSRF_COOKIE_NAME=tmi_csrf
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_EMAIL_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=900
AUTH_PASSWORD_RESET_TTL_SECONDS=3600
AUTH_PASSWORD_RESET_IP_LIMIT=10
AUTH_PASSWORD_RESET_EMAIL_LIMIT=3
AUTH_PASSWORD_RESET_RATE_WINDOW_SECONDS=900
# Firebase Authentication / Google sign-in (web app config)
# FIREBASE_PROJECT_ID must equal NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# Backend Firebase Admin operations use Application Default Credentials (ADC).
# In production prefer workload identity. For local development, point
# GOOGLE_APPLICATION_CREDENTIALS to a service-account file kept outside this repo.
FIREBASE_PROJECT_ID=tmi-local
FIREBASE_AUTH_EMULATOR_HOST=firebase-emulator:9099
FIREBASE_JWKS_URI=https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com
FIREBASE_TIMEOUT_SECONDS=5
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tmi-local
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
OAUTH_RATE_LIMIT=10
OAUTH_RATE_WINDOW_SECONDS=60
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_SIGNATURE_TTL_SECONDS=3600
MEDIA_DELIVERY_TTL_SECONDS=300
MEDIA_AVATAR_MAX_BYTES=5242880
MEDIA_EVIDENCE_MAX_BYTES=31457280
DOCUMENT_VERIFICATION_MAX_BYTES=26214400
MEDIA_PROVIDER_TIMEOUT_SECONDS=5
MEDIA_SCANNER_HOST=clamav
MEDIA_SCANNER_PORT=3310
MEDIA_SCANNER_TIMEOUT_SECONDS=15
MEDIA_INSPECTION_MAX_ATTEMPTS=5
MEDIA_PRIVATE_ENCRYPTION_ENABLED=false
MEDIA_PRIVATE_ENCRYPTION_ACTIVE_KEY_ID=
MEDIA_PRIVATE_ENCRYPTION_KEYS={}
POLYGON_RPC_URL=
POLYGON_CHAIN_ID=80002
BLOCKCHAIN_NETWORK=local
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_RPC_URL=http://anvil:8545
# THVProofRegistry deployment / role-verification variables. The application
# does not read a human signer's private key.
ADMIN_WALLET_ADDRESS=
SIGNER_WALLET_ADDRESS=
THV_PROOF_REGISTRY_CONTRACT_ADDRESS=
THV_PROOF_REGISTRY_CONTRACT_ABI_PATH=/contracts/artifacts/THVProofRegistry.abi.json
BLOCKCHAIN_ALLOWED_CONTRACT_ADDRESSES=
BLOCKCHAIN_SIGNER_MODE=human
BLOCKCHAIN_SIGNING_ENABLED=true
# Human signing never needs a private key in the application. Leave this blank.
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
BLOCKCHAIN_REQUIRED_CONFIRMATIONS=1
BLOCKCHAIN_WALLET_CHALLENGE_TTL_SECONDS=600
BLOCKCHAIN_TRANSACTION_INTENT_TTL_SECONDS=600
BLOCKCHAIN_NONCE_LOCK_TTL_SECONDS=30
BLOCKCHAIN_EXPLORER_BASE_URL=
PUBLIC_RATE_LIMIT=120
PUBLIC_RATE_WINDOW_SECONDS=60
PUBLIC_CATALOG_CACHE_TTL_SECONDS=60
VOTING_SUMMARY_CACHE_TTL_SECONDS=30
SEARCH_STATEMENT_TIMEOUT_MS=400
SEARCH_TRIGRAM_MIN_LENGTH=4
SEARCH_TRIGRAM_THRESHOLD=0.3
SEARCH_TRIGRAM_MAX_BOOST=0.25
SEARCH_RATE_LIMIT=60
SEARCH_RATE_WINDOW_SECONDS=60
VOTING_USER_RATE_LIMIT=20
VOTING_IP_RATE_LIMIT=100
VOTING_RATE_WINDOW_SECONDS=60
SEARCH_HISTORY_RETENTION_DAYS=90
SEARCH_HISTORY_LIST_LIMIT=10
PUBLIC_VERIFICATION_CACHE_TTL_SECONDS=30
PUBLIC_SITEMAP_PAGE_SIZE=10000
PUBLIC_SITEMAP_CACHE_TTL_SECONDS=86400
PUBLIC_REPORT_RATE_LIMIT=5
PUBLIC_REPORT_RATE_WINDOW_SECONDS=3600
PUBLIC_ENGAGEMENT_RATE_LIMIT=30
PUBLIC_ENGAGEMENT_RATE_WINDOW_SECONDS=60
ENGAGEMENT_VIEW_DEDUPE_TTL_SECONDS=86400
ENGAGEMENT_VISITOR_COOKIE_NAME=tmi_engagement_visitor
ENGAGEMENT_VISITOR_HMAC_SECRET=
ENGAGEMENT_ACTIVITY_RETENTION_DAYS=365
CORS_ALLOWED_ORIGINS=http://localhost:3000
MEDIA_UPLOAD_SIGNATURE_RATE_LIMIT=20
MEDIA_UPLOAD_SIGNATURE_RATE_WINDOW_SECONDS=60
CERTIFICATE_VALIDITY_DAYS=365
CERTIFICATE_TEMPLATE_VERSION=certificate-red-gold-v1
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SENDER=no-reply@tmigroup.vn
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
EMAIL_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=
