APP_ENV=staging
APP_BASE_URL=https://staging.example.com
API_BASE_URL=https://staging.example.com/api

# Polygon Amoy release values. Inject secrets from CI or a secret manager.
AMOY_RPC_URL=https://replace-with-amoy-rpc
DEPLOYER_PRIVATE_KEY=inject-from-secret-manager
EXPECTED_DEPLOYER=0x0000000000000000000000000000000000000000
CONTRACT_ADMIN=0x0000000000000000000000000000000000000000
EXPECTED_CONTRACT_ADMIN=0x0000000000000000000000000000000000000000
ISSUER_ADDRESS=0x0000000000000000000000000000000000000000
EXPECTED_ISSUER=0x0000000000000000000000000000000000000000
POLYGONSCAN_API_KEY=inject-from-secret-manager

BLOCKCHAIN_NETWORK=amoy
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_RPC_URL=https://replace-with-amoy-rpc
THV_PROOF_REGISTRY_CONTRACT_ADDRESS=replace-after-deployment
THV_PROOF_REGISTRY_CONTRACT_ABI_PATH=/contracts/artifacts/THVProofRegistry.abi.json
BLOCKCHAIN_ALLOWED_CONTRACT_ADDRESSES=replace-after-deployment
BLOCKCHAIN_SIGNER_MODE=human
BLOCKCHAIN_SIGNING_ENABLED=true
BLOCKCHAIN_REQUIRED_CONFIRMATIONS=5
BLOCKCHAIN_EXPLORER_BASE_URL=https://amoy.polygonscan.com
