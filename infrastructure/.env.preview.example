# V1 public preview: auth, account and public catalog only.
REGISTRY=ghcr.io/example
IMAGE_PREFIX=tinh-hoa-viet
APP_DOMAIN=decu.tinhhoaviet.org.vn
TLS_CERTIFICATE_DIR=/etc/letsencrypt
DEPLOY_HEALTH_TIMEOUT_SECONDS=180
AUTO_ROLLBACK_ON_FAILURE=true
EDGE_PROXY_MODE=host-nginx
FRONTEND_HOST_PORT=3100
BACKEND_HOST_PORT=8100

APP_ENV=production
RELEASE_MODE=preview
APP_BASE_URL=https://decu.tinhhoaviet.org.vn
CORS_ALLOWED_ORIGINS=https://decu.tinhhoaviet.org.vn
DATABASE_URL=postgresql+asyncpg://replace?ssl=require
DATABASE_DIRECT_URL=postgresql+asyncpg://replace?ssl=require
DATABASE_NULL_POOL=false
REDIS_PASSWORD=replace
REDIS_URL=redis://:replace@redis:6379/0

JWT_SECRET=inject-from-secret-manager
AUTH_CSRF_SECRET=inject-from-secret-manager
AUTH_OUTBOX_ENCRYPTION_KEY=inject-from-secret-manager
AUTH_OUTBOX_KEY_ID=auth-registration-v1
PII_ENCRYPTION_KEY=inject-from-secret-manager
AUDIT_INTEGRITY_KEY=inject-at-least-32-characters-from-secret-manager
AUDIT_INTEGRITY_KEY_ID=audit-v1
AUDIT_INTEGRITY_VERIFICATION_KEYS={}
AUTH_JWT_ISSUER=tmi-platform
AUTH_JWT_AUDIENCE=tmi-web

FIREBASE_PROJECT_ID=replace

PAYMENT_PROVIDER=disabled
PAYMENT_REAL_MONEY_TEST_ENABLED=false

ENGAGEMENT_VISITOR_HMAC_SECRET=inject-from-secret-manager
