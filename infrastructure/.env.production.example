REGISTRY=ghcr.io/example
IMAGE_PREFIX=tinh-hoa-viet
IMAGE_TAG=replace-with-release-sha
APP_DOMAIN=decu.tinhhoaviet.org.vn
TLS_CERTIFICATE_DIR=/etc/letsencrypt
PRODUCTION_ENV_FILE=.env.production
DEPLOY_HEALTH_TIMEOUT_SECONDS=180
AUTO_ROLLBACK_ON_FAILURE=true

APP_ENV=production
APP_BASE_URL=https://decu.tinhhoaviet.org.vn
API_BASE_URL=http://backend:8000
CORS_ALLOWED_ORIGINS=https://decu.tinhhoaviet.org.vn
DATABASE_URL=postgresql+asyncpg://replace
DATABASE_DIRECT_URL=postgresql+asyncpg://replace
DATABASE_NULL_POOL=false
REDIS_PASSWORD=replace
REDIS_URL=redis://:replace@redis:6379/0
JWT_SECRET=replace
AUTH_CSRF_SECRET=replace
AUTH_OUTBOX_ENCRYPTION_KEY=replace
AUTH_OUTBOX_KEY_ID=auth-registration-v1
STAFF_INVITATION_TTL_SECONDS=86400
FIREBASE_TOTP_ENABLED=true
STAFF_MFA_MAX_AGE_SECONDS=43200
PII_ENCRYPTION_KEY=replace
AUDIT_INTEGRITY_KEY=inject-at-least-32-characters-from-secret-manager
AUDIT_INTEGRITY_KEY_ID=audit-v1
AUDIT_INTEGRITY_VERIFICATION_KEYS={}
AUTH_JWT_ISSUER=tmi-platform
AUTH_JWT_AUDIENCE=tmi-web
CLOUDINARY_CLOUD_NAME=replace
CLOUDINARY_API_KEY=replace
CLOUDINARY_API_SECRET=replace
MEDIA_PRIVATE_ENCRYPTION_ENABLED=true
MEDIA_PRIVATE_ENCRYPTION_ACTIVE_KEY_ID=document-v1
MEDIA_PRIVATE_ENCRYPTION_KEYS={"document-v1":"replace-with-base64-32-byte-key"}
# Firebase Authentication / Google sign-in. Copy values from Firebase Console.
FIREBASE_PROJECT_ID=replace
FIREBASE_JWKS_URI=https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com
FIREBASE_TIMEOUT_SECONDS=5
NEXT_PUBLIC_FIREBASE_API_KEY=replace
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace
NEXT_PUBLIC_FIREBASE_APP_ID=replace
PAYMENT_PROVIDER=payos
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CHECKOUT_BASE_URL=http://localhost:3000/payments/mock
PAYMENT_AMOUNT_MINOR=1000000
PAYMENT_CURRENCY=VND
PAYMENT_ORDER_TTL_SECONDS=900
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_CLIENT_ID=inject-from-secret-manager
PAYOS_API_KEY=inject-from-secret-manager
PAYOS_CHECKSUM_KEY=inject-from-secret-manager
PAYOS_RETURN_URL=https://app.example.com/payments/return
PAYOS_CANCEL_URL=https://app.example.com/payments/cancel
PAYOS_TIMEOUT_SECONDS=8
PAYMENT_REAL_MONEY_TEST_ENABLED=false
PAYMENT_REAL_MONEY_TEST_MAX_AMOUNT_VND=10000
BLOCKCHAIN_NETWORK=polygon
BLOCKCHAIN_CHAIN_ID=137
BLOCKCHAIN_RPC_URL=https://replace
CERTIFICATE_CONTRACT_ADDRESS=replace
BLOCKCHAIN_ALLOWED_CONTRACT_ADDRESSES=replace
BLOCKCHAIN_SIGNER_MODE=managed
BLOCKCHAIN_MANAGED_SIGNER_URL=https://signer.example.com/v1/sign
BLOCKCHAIN_MANAGED_SIGNER_KEY_ID=replace-with-managed-key-resource
BLOCKCHAIN_MANAGED_SIGNER_EXPECTED_ADDRESS=replace-with-signer-address
BLOCKCHAIN_MANAGED_SIGNER_TIMEOUT_SECONDS=8
BLOCKCHAIN_REQUIRED_CONFIRMATIONS=3
BLOCKCHAIN_EXPLORER_BASE_URL=https://polygonscan.com
ENGAGEMENT_VISITOR_HMAC_SECRET=replace
SMTP_HOST=replace
SMTP_PORT=587
SMTP_SENDER=no-reply@example.com
