limit_req_zone $binary_remote_addr zone=tmi_api_per_ip:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=tmi_verify_per_ip:10m rate=5r/s;

server {
    listen 80;
    listen [::]:80;
    server_name decu.tinhhoaviet.org.vn;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name decu.tinhhoaviet.org.vn;

    ssl_certificate /etc/letsencrypt/live/decu.tinhhoaviet.org.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/decu.tinhhoaviet.org.vn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TMI_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 1m;
    server_tokens off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https:; font-src 'self' data:" always;

    gzip on;
    gzip_types application/json application/javascript text/css text/plain image/svg+xml;

    location = /health {
        access_log off;
        proxy_pass http://127.0.0.1:8100/health;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location /api/v1/verify/ {
        limit_req zone=tmi_verify_per_ip burst=10 nodelay;
        proxy_pass http://127.0.0.1:8100;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location /api/ {
        limit_req zone=tmi_api_per_ip burst=40 nodelay;
        proxy_pass http://127.0.0.1:8100;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location / {
        proxy_pass http://127.0.0.1:3100;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }
}
